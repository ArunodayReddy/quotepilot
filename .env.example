# QuotePilot environment — copy to .env and fill in. NEVER commit .env.
# No secrets are checked into the repo, ever.

# API port (default 3001)
PORT=3001

# Email delivery (SMTP). Empty = dev mode: emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=quotes@example.com

# Runtime
NODE_ENV=development

# CORS: comma-separated allowed origins for the API. In production set this to
# your deployed web URL, e.g. https://quotepilot.vercel.app
# (dev defaults to http://localhost:5173 and :5174 automatically)
CORS_ORIGIN=

# Public base URL of the web app (used in quote emails). Dev default is localhost.
APP_BASE_URL=http://localhost:5173

# --- Web app (apps/web/.env) ---
# Production API origin for the Vite build. Leave empty in dev (uses the /api proxy).
# VITE_API_URL=https://quotepilot-api.onrender.com

# Salt for hashing analytics session IDs (REQUIRED in production; any random string)
ANALYTICS_SALT=

# Live agent directory (Google Places API). Empty = sample seed fallback.
# Get a key: Google Cloud Console → APIs & Services → enable "Places API"
# → Credentials → Create API key. Restrict the key to your site in production.
# Without this key the agents endpoint serves the sample directory
# (badged "Sample data" in the UI) — nothing breaks.
GOOGLE_PLACES_API_KEY=
